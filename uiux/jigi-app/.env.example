# =============================================================================
# JIGI APP - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Client-safe - bundled into frontend)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# AUTH ALLOWLIST (Client — invite-only sign-in when enabled)
# -----------------------------------------------------------------------------
# Set to true in production to restrict sign-up / sign-in to approved emails.
# When false, any email can register (recommended for local dev only).
VITE_AUTH_ALLOWLIST_ENABLED=false
# Comma-separated full emails (lowercase applied automatically)
VITE_AUTH_ALLOWED_EMAILS=you@yourcompany.com
# Comma-separated email domains without @
VITE_AUTH_ALLOWED_DOMAINS=yourcompany.com

# Supabase dashboard: Authentication → Providers → Google (enable OAuth)
# Add redirect URL: http://localhost:5173/auth/callback (and production URL)

# -----------------------------------------------------------------------------
# SUPABASE (Server-only - for API routes, NEVER expose to frontend)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# REPLICATE (Server-only - for Flux image generation)
# -----------------------------------------------------------------------------
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-replicate-token
# fal.ai — preferred open-weight / long-tail lane (before Replicate when set)
FAL_KEY=
# Optional per-tier overrides: FAL_IMAGE_MODEL_DRAFT / _REFINE / _FINAL

# -----------------------------------------------------------------------------
# LLM TEXT GENERATION (Server-only - concepts, copy, compliance, prompt refine)
# -----------------------------------------------------------------------------
# Provider selector: openrouter (default) | azure
LLM_PROVIDER=openrouter

# OpenRouter — one key, many models, with built-in fallback.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# Model slug (see https://openrouter.ai/models). Must support JSON output.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional attribution headers shown on the OpenRouter dashboard
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Jigi

# -----------------------------------------------------------------------------
# AZURE OPENAI (LEGACY / OPTIONAL - only used when LLM_PROVIDER=azure)
# -----------------------------------------------------------------------------
# Retained for fallback; safe to leave blank when using OpenRouter.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_GPT=gpt-4o-mini

# Image generation: use GPT Image family (DALL·E 3 deprecated Mar 2026)
AZURE_OPENAI_DEPLOYMENT_DALLE=gpt-image-1-mini
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1-mini
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# -----------------------------------------------------------------------------
# AZURE AI FOUNDRY FLUX (Server-only - FLUX.2-flex image generation)
# -----------------------------------------------------------------------------
# From Azure AI Foundry deployment: Target URI + API key (Bearer auth)
# When set, used as primary image route in azure_only mode
# Full Target URI from Azure Foundry deployment. Must use services.ai.azure.com (not cognitiveservices.azure.com)
AZURE_FOUNDRY_FLUX_ENDPOINT=https://your-resource.services.ai.azure.com/providers/blackforestlabs/v1/flux-2-flex?api-version=preview
AZURE_FOUNDRY_FLUX_API_KEY=your-foundry-flux-api-key
# Optional model override (default: flux-2-flex)
# AZURE_FOUNDRY_FLUX_MODEL=flux-2-flex

# -----------------------------------------------------------------------------
# GOOGLE NANO BANANA (Server-only - Gemini image models; Final tier primary)
# -----------------------------------------------------------------------------
# Get your key from Google AI Studio. Imagen 4 was shut down 2026-08-17; any
# imagen-* override (incl. legacy GOOGLE_IMAGEN_MODEL_*) is ignored at runtime.
GOOGLE_AI_API_KEY=your-google-ai-api-key
# GOOGLE_IMAGE_ENDPOINT_BASE=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_IMAGE_MODEL_DRAFT=gemini-3.1-flash-lite-image
# GOOGLE_IMAGE_MODEL_REFINE=gemini-nano-banana-2.1
# GOOGLE_IMAGE_MODEL_FINAL=gemini-nano-banana-2.1

# -----------------------------------------------------------------------------
# KLING (Server-only - Draft + Refine tier primary)
# -----------------------------------------------------------------------------
# Kling console → API Keys. Use KLING_API_KEY, or the legacy access/secret pair.
KLING_API_KEY=
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# KLING_API_BASE=https://api-singapore.klingai.com
# KLING_POLL_TIMEOUT_MS=40000  (leaves room inside the 60s function budget to fall back)
# KLING_IMAGE_MODEL_DRAFT=kling-v2-1
# KLING_IMAGE_MODEL_REFINE=kling-v3
# KLING_IMAGE_MODEL_FINAL=kling-v3

# Upscale (Generation Studio P2) — runs on Replicate
# REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan

# -----------------------------------------------------------------------------
# IMAGE ROUTING GUARDRAILS (Server-only)
# -----------------------------------------------------------------------------
# Provider mode:
# - hybrid: primary lanes per tier (Kling / Nano Banana), then Foundry, Replicate,
#   then optional Azure OpenAI paid fallback. See server/api/lib/image-routing.ts.
# - azure_only: force Azure image route while keeping other adapters in code
IMAGE_ROUTING_PROVIDER_MODE=hybrid
# Keep paid fallback off in initial rollout; enable later with a strict cap.
IMAGE_ROUTING_ENABLE_PAID_FALLBACK=false
IMAGE_CAP_DRAFT_DAILY=300
IMAGE_CAP_REFINE_DAILY=120
IMAGE_CAP_FINAL_DAILY=40
IMAGE_CAP_PER_USER_DAILY=24
IMAGE_CAP_PER_CAMPAIGN_DAILY=18
IMAGE_PAID_CAP_GLOBAL_DAILY=12
REPLICATE_IMAGE_MODEL_DRAFT=black-forest-labs/flux-schnell
REPLICATE_IMAGE_MODEL_REFINE=black-forest-labs/flux-dev
REPLICATE_IMAGE_MODEL_FINAL=black-forest-labs/flux-dev
AZURE_OPENAI_IMAGE_MODEL_DRAFT=gpt-image-1-mini
AZURE_OPENAI_IMAGE_MODEL_REFINE=gpt-image-1-mini
AZURE_OPENAI_IMAGE_MODEL_FINAL=gpt-image-1-mini

# -----------------------------------------------------------------------------
# RESEND (Server-only - for transactional email)
# -----------------------------------------------------------------------------
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=Jigi <notifications@jigi.app>

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
# Video generation scaffold (POST /api/generate/video returns 501 until a provider ships)
VIDEO_ENABLED=false

# -----------------------------------------------------------------------------
# CRON (Server-only - for Vercel cron job authentication)
# -----------------------------------------------------------------------------
CRON_SECRET=generate-a-random-32-char-string
